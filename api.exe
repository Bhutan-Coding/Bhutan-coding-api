from flask import Flask, jsonify, request, render_code, redirect, url_for

app = Flask(__name__)

# Mock database simulating user registration and extension storage
users_db = {}
extensions_db = [
    {"id": "ext_01", "name": "Bhutan Block Mod", "version": "1.0.0", "author": "OpenSnail"},
    {"id": "ext_02", "name": "Snail IDE Bridge", "version": "2.1.0", "author": "Bhutan Coding"}
]

@app.route('/')
def home():
    return jsonify({
        "message": "Welcome to the Bhutan Coding API (Python Implementation)",
        "base_ide": "Snail IDE Modded Framework",
        "status": "online"
    })

# Replicating functionality for api.js: Serves extensions data
@app.route('/api/extensions', methods=['GET'])
def get_extensions():
    return jsonify({
        "status": "success",
        "count": len(extensions_db),
        "data": extensions_db
    })

# Replicating functionality for register.php / signup.html
@app.route('/api/register', methods=['POST'])
def register_user():
    data = request.get_json() or request.form
    username = data.get('username')
    password = data.get('password')

    if not username or not password:
        return jsonify({"status": "error", "message": "Missing credentials"}), 400

    if username in users_db:
        return jsonify({"status": "error", "message": "User already exists"}), 400

    # Save to mock database
    users_db[username] = password
    return jsonify({"status": "success", "message": "User registered successfully"}), 201

# Replicating functionality for login.html
@app.route('/api/login', methods=['POST'])
def login_user():
    data = request.get_json() or request.form
    username = data.get('username')
    password = data.get('password')

    if users_db.get(username) == password:
        return jsonify({"status": "success", "message": "Login successful", "redirect": "/download.html"})
    
    return jsonify({"status": "error", "message": "Invalid username or password"}), 401

# Replicating functionality for redirect.js / reject.js logic
@app.route('/api/validate-access', methods=['GET'])
def validate_access():
    authorized = request.args.get('auth') == 'true'
    if authorized:
        return redirect(url_for('home'))
    else:
        return jsonify({"status": "rejected", "message": "Access denied by Bhutan Coding policy."}), 403

if __name__ == '__main__':
    # Run server locally on port 5000
    app.run(debug=True, port=5000)
